# Copiá este archivo a ".env" (mismo directorio) y completá tus valores.
# ".env" NUNCA se sube al repo (está en .gitignore) porque tiene secretos.

# Puerto donde escucha la API de Go
PORT=8080

# Connection string de Postgres. Formato:
# postgres://usuario:password@host:puerto/nombre_de_base?sslmode=disable
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/turnos_centro_mujer?sslmode=disable

# Origen permitido para CORS (el dev server del frontend). Vite usa
# el puerto 5173 por defecto.
FRONTEND_URL=http://localhost:5173
